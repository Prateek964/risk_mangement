# Copy to .env (gitignored). Never commit real values.
# Google Sheets: share the sheet with the service account's client_email (Editor).
FACTORY_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Branch that the local worker pushes mood boards to and the renderer pushes outputs to.
FACTORY_GIT_BRANCH=claude/peaceful-carson-hqvun4
